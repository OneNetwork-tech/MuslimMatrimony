@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.Localization

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject IViewLocalizer Localizer

<!--
    This partial view contains the logic to display different actions
    based on the user's authentication status. It is typically included
    in the main layout file (_Layout.cshtml).
-->

<ul class="flex items-center space-x-4">

    @if (SignInManager.IsSignedIn(User))
    {
        <!-- If the user is signed in, show a welcome message and management links -->
        <li class="nav-item">
            <a class="text-gray-600 hover:text-green-700" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">@Localizer["Hello"] @User.Identity?.Name!</a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="text-gray-600 hover:text-green-700 border-none bg-transparent p-0">@Localizer["Logout"]</button>
            </form>
        </li>
    }
    else
    {
        <!-- If the user is not signed in, show Register and Login links -->
        <li class="nav-item">
            <a class="text-gray-600 hover:text-green-700" asp-area="Identity" asp-page="/Account/Register">@Localizer["Register"]</a>
        </li>
        <li class="nav-item">
            <a class="bg-green-700 text-white font-semibold px-4 py-2 rounded-lg hover:bg-green-800 transition duration-300" asp-area="Identity" asp-page="/Account/Login">@Localizer["Login"]</a>
        </li>
    }

</ul>
