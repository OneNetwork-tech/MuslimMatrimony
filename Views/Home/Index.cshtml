@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Home Page"];
}

<!--
    This is the main view for your homepage. It uses the IViewLocalizer service
    to fetch text in the currently selected language (English or Swedish).
    The overall page structure (like the <head> tag and header/footer)
    is typically defined in the _Layout.cshtml file.
-->
<!-- Main Content -->
<main>
    <!-- Hero Section -->
    <section class="hero-bg py-20 md:py-32">
        <div class="container mx-auto px-6 text-center">
            <h1 class="text-4xl md:text-6xl font-bold text-gray-800 leading-tight">@Localizer["Find Your Righteous Partner"]</h1>
            <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">@Localizer["A trusted platform for practicing Muslims to find a spouse based on Islamic values, shared interests, and life goals."]</p>
            <div class="mt-8">
                <!-- This link uses ASP.NET Tag Helpers to direct users to the registration page -->
                <a asp-area="Identity" asp-page="/Account/Register" class="bg-green-700 text-white font-bold text-lg px-8 py-4 rounded-lg hover:bg-green-800 transition duration-300 transform hover:scale-105">@Localizer["Start Your Search"]</a>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="py-20 bg-white">
        <div class="container mx-auto px-6">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800">@Localizer["Why Choose Nikah Noor?"]</h2>
                <p class="text-gray-600 mt-2">@Localizer["We are dedicated to helping you find a compatible life partner in a safe and Halal environment."]</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
                <!-- Feature 1 -->
                <div class="bg-gray-50 p-8 rounded-xl shadow-md text-center hover:shadow-lg transition-shadow duration-300">
                    <div class="flex items-center justify-center h-16 w-16 rounded-full bg-green-100 text-green-700 mx-auto mb-4">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-800 mb-2">@Localizer["Verified Profiles"]</h3>
                    <p class="text-gray-600">@Localizer["We manually review profiles to ensure a high-quality and genuine user base."]</p>
                </div>
                <!-- Feature 2 -->
                <div class="bg-gray-50 p-8 rounded-xl shadow-md text-center hover:shadow-lg transition-shadow duration-300">
                    <div class="flex items-center justify-center h-16 w-16 rounded-full bg-green-100 text-green-700 mx-auto mb-4">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-800 mb-2">@Localizer["Privacy Control"]</h3>
                    <p class="text-gray-600">@Localizer["You control who sees your photos and personal information, ensuring your privacy."]</p>
                </div>
                <!-- Feature 3 -->
                <div class="bg-gray-50 p-8 rounded-xl shadow-md text-center hover:shadow-lg transition-shadow duration-300">
                    <div class="flex items-center justify-center h-16 w-16 rounded-full bg-green-100 text-green-700 mx-auto mb-4">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"></path></svg>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-800 mb-2">@Localizer["Compatibility Focus"]</h3>
                    <p class="text-gray-600">@Localizer["Our detailed profiles help you find matches based on deep compatibility."]</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials Section -->
    <section class="py-20 hero-bg">
        <div class="container mx-auto px-6">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800">@Localizer["Success Stories"]</h2>
                <p class="text-gray-600 mt-2">@Localizer["Alhamdulillah, many have found their life partners with us."]</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-10 max-w-4xl mx-auto">
                <!-- Story 1 -->
                <div class="bg-white p-6 rounded-lg shadow-md">
                    <p class="text-gray-600 italic">@Localizer["I was losing hope but decided to try Nikah Noor. I found my husband here, and I couldn't be more grateful. The platform is serious and respectful."]</p>
                    <div class="mt-4 font-semibold text-gray-800">@Localizer["- Fatima & Ahmed, USA"]</div>
                </div>
                <!-- Story 2 -->
                <div class="bg-white p-6 rounded-lg shadow-md">
                    <p class="text-gray-600 italic">@Localizer["The detailed profiles helped me find someone who truly shared my values and deen. JazakAllah Khair to the team for this wonderful service."]</p>
                    <div class="mt-4 font-semibold text-gray-800">@Localizer["- Yusuf & Ayesha, UK"]</div>
                </div>
            </div>
        </div>
    </section>
</main>
