@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Privacy Policy"];
}

<!--
    This view is for your Privacy Policy page.
    It uses IViewLocalizer to display text in the user's selected language.
    You should replace the placeholder text below with your actual privacy policy details.
-->

<div class="container mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold text-gray-800 mb-4">@ViewData["Title"]</h1>

    <div class="prose max-w-none text-gray-700">
        <p>@Localizer["Your privacy is important to us. It is Nikah Noor's policy to respect your privacy regarding any information we may collect from you across our website."]</p>

        <h2 class="text-2xl font-semibold text-gray-800 mt-6 mb-3">@Localizer["Information We Collect"]</h2>
        <p>@Localizer["We only ask for personal information when we truly need it to provide a service to you. We collect it by fair and lawful means, with your knowledge and consent. We also let you know why we’re collecting it and how it will be used."]</p>
        <p>@Localizer["The personal information that we may collect includes, but is not limited to:"]</p>
        <ul>
            <li>@Localizer["Name and contact details (email, phone number)"]</li>
            <li>@Localizer["Demographic information such as age, gender, and location"]</li>
            <li>@Localizer["Personal details for your matrimonial profile such as marital status, religious practices, profession, and education"]</li>
            <li>@Localizer["Photographs you choose to upload"]</li>
        </ul>

        <h2 class="text-2xl font-semibold text-gray-800 mt-6 mb-3">@Localizer["How We Use Your Information"]</h2>
        <p>@Localizer["We use the information we collect in various ways, including to:"]</p>
        <ul>
            <li>@Localizer["Provide, operate, and maintain our website"]</li>
            <li>@Localizer["Improve, personalize, and expand our website"]</li>
            <li>@Localizer["Understand and analyze how you use our website"]</li>
            <li>@Localizer["Enable matchmaking and communication between members"]</li>
            <li>@Localizer["Communicate with you, either directly or through one of our partners, including for customer service, to provide you with updates and other information relating to the website, and for marketing and promotional purposes"]</li>
            <li>@Localizer["Find and prevent fraud"]</li>
        </ul>

        <h2 class="text-2xl font-semibold text-gray-800 mt-6 mb-3">@Localizer["Security"]</h2>
        <p>@Localizer["We take the security of your data seriously and use appropriate technical and organizational measures to protect your personal information. However, no electronic transmission or storage is 100% secure, and we cannot guarantee its absolute security."]</p>

        <p class="mt-6">@Localizer["This policy is effective as of 25 June 2025."]</p>
    </div>
</div>
