@*
    This file provides global using directives for all views in the project.
    By adding namespaces here, you don't have to add @using directives
    at the top of every single .cshtml file.
*@

@using MuslimMatrimony
@using MuslimMatrimony.Models

@* This adds the built-in ASP.NET Core Tag Helpers (like asp-controller, 
    asp-action, asp-validation-for) which make writing server-side code
    in your HTML much cleaner and more powerful.
*@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

