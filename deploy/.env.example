# Server settings for deploy/docker-compose.yml. Copy to .env next to it. Never commit .env.

# Image to run: latest (default branch), a branch name (e.g. claude-charming-noether-lhy664) or sha-<7 chars>
IMAGE_TAG=latest
WEB_PORT=8083

# Required. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# Plain HTTP on a LAN: keep false (otherwise login cookies are HTTPS-only).
# Set true once a TLS reverse proxy is in front.
Security__HttpsOnly=false

# Email for account confirmation and password reset. Without Email__Host nothing is
# sent, so new members can't confirm their accounts.
Email__Host=
Email__Port=587
Email__Security=StartTls
Email__Username=
Email__Password=
Email__From=
# Testing without a mail server: print whole emails (with links) to the log. Keep false in production.
Email__LogBodies=false
Email__FromName=Nikah Noor

# Moderators (confirmed accounts with these emails get the Admin role on startup)
# Admin__Emails__0=

# --- Behind an HTTPS reverse proxy on this server (see Caddyfile.example) ---
# Uncomment these, and comment out Security__HttpsOnly=false above.
# Security__HttpsOnly=true
# Trust the proxy for the client IP and https scheme. Without this you get a redirect
# loop. Docker networks use 172.16.0.0/12 by default
# (check with: docker network inspect muslimmatrimony_default).
# ForwardedHeaders__KnownNetworks__0=172.16.0.0/12
# Only the proxy can reach the app; plain http://<server-ip>:8083 stops working.
# BIND_ADDRESS=127.0.0.1
