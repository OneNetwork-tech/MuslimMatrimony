# Copy to .env and fill in. Never commit .env.

# Database password (generate: openssl rand -base64 24)
POSTGRES_PASSWORD=
POSTGRES_DB=muslimmatrimony
POSTGRES_USER=muslimmatrimony

# Outgoing email (account confirmation, password reset, match notifications).
# Without Email__Host, emails are NOT sent; a warning is logged instead.
Email__Host=
Email__Port=587
Email__Security=StartTls
Email__Username=
Email__Password=
Email__From=
Email__FromName=Nikah Noor

# Moderators: confirmed accounts with these emails get the Admin role on startup.
# Admin__Emails__0=

# If you run behind a reverse proxy, list its IPs so X-Forwarded-* headers are trusted
# ForwardedHeaders__KnownProxies__0=10.0.0.10

WEB_PORT=8080

# HTTPS-only cookies, HSTS and redirect (default true). Set false only to test over plain HTTP on a LAN.
# Security__HttpsOnly=true
