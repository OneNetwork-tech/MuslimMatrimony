@{
    ViewData["Title"] = L["Find your righteous partner"];
    ViewData["FullWidth"] = true;
}
<section class="hero py-5">
    <div class="container py-lg-5 text-center">
        <h1 class="display-5 fw-bold">@L["Find your righteous partner"]</h1>
        <p class="lead col-lg-8 mx-auto">@L["A respectful platform for Muslims seeking marriage, built around Islamic values, privacy and the involvement of family."]</p>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg mt-3">@L["Create a free profile"]</a>
    </div>
</section>

<section id="how" class="py-5 bg-white">
    <div class="container">
        <h2 class="text-center mb-4">@L["How it works"]</h2>
        <div class="row g-4">
            <div class="col-md-3"><div class="feature"><span class="step">1</span><h3 class="h5">@L["Create your profile"]</h3><p>@L["Tell others about your deen, family and what you are looking for."]</p></div></div>
            <div class="col-md-3"><div class="feature"><span class="step">2</span><h3 class="h5">@L["Search"]</h3><p>@L["Filter by age, location, marital status and religious practice."]</p></div></div>
            <div class="col-md-3"><div class="feature"><span class="step">3</span><h3 class="h5">@L["Show interest"]</h3><p>@L["When the interest is mutual, it's a match."]</p></div></div>
            <div class="col-md-3"><div class="feature"><span class="step">4</span><h3 class="h5">@L["Talk with respect"]</h3><p>@L["Only matches can message each other, and wali details are shared with matches."]</p></div></div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <h2 class="text-center mb-4">@L["Why Nikah Noor?"]</h2>
        <div class="row g-4">
            <div class="col-md-4"><div class="feature"><h3 class="h5">@L["Moderated photos"]</h3><p>@L["Every photo is reviewed by a moderator, and location data is removed from uploaded images."]</p></div></div>
            <div class="col-md-4"><div class="feature"><h3 class="h5">@L["Privacy control"]</h3><p>@L["By default only your matches see your photos. You can pause your profile at any time."]</p></div></div>
            <div class="col-md-4"><div class="feature"><h3 class="h5">@L["Safe and in your control"]</h3><p>@L["Block or report anyone, download your data, or delete your account with one click."]</p></div></div>
        </div>
    </div>
</section>
