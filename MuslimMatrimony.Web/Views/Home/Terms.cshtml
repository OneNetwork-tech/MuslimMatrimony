@{
    ViewData["Title"] = L["Terms of service"];
}
<article class="col-lg-9 legal">
    <h1 class="h2">@ViewData["Title"]</h1>
    <p class="text-muted">@L["Version"] @Consent.CurrentVersion</p>
    <ol>
        <li>@L["Nikah Noor is for single Muslims aged 18 or over who are seeking marriage."]</li>
        <li>@L["You must give truthful information and use only photos of yourself."]</li>
        <li>@L["Treat other members with respect. Harassment, explicit content, requests for money and commercial use are not allowed."]</li>
        <li>@L["Do not share other members' personal information or photos outside the platform."]</li>
        <li>@L["Moderators may reject photos and suspend accounts that break these terms."]</li>
        <li>@L["Meet in safe, public places and involve your family or wali. Nikah Noor does not verify identities and is not responsible for members' conduct."]</li>
        <li>@L["You can delete your account at any time."]</li>
    </ol>
</article>
